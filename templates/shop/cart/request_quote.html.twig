{% set cart = hookable_metadata.context.cart|default(null) %}

{% if tmonier_quote_request_setting('from_cart') and cart is not null and cart.items|length > 0 and tmonier_quote_request_cart_quote(cart) is null %}
    <div class="container">
        <div class="card my-4" {{ sylius_test_html_attribute('tmonier-request-quote-from-cart') }}>
            <div class="card-body d-flex flex-wrap gap-3 justify-content-between align-items-center">
                <div>
                    <div class="fw-bold">{{ 'tmonier_quote_request.ui.need_large_quantities'|trans }}</div>
                    <div class="text-body-secondary small">{{ 'tmonier_quote_request.ui.request_quote_for_cart_help'|trans }}</div>
                </div>
                <form method="post" action="{{ path('tmonier_quote_request_shop_from_cart') }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('tmonier_quote_request_from_cart') }}">
                    <button type="submit" class="btn btn-outline-primary" {{ sylius_test_html_attribute('tmonier-request-quote-from-cart-button') }}>
                        {{ ux_icon('tabler:file-dollar', {'class': 'icon'}) }}
                        {{ 'tmonier_quote_request.ui.request_quote_for_cart'|trans }}
                    </button>
                </form>
            </div>
        </div>
    </div>
{% endif %}
