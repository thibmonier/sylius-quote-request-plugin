{% extends '@SyliusShop/shared/layout/base.html.twig' %}
{% from '@SyliusShop/shared/breadcrumbs.html.twig' import breadcrumbs %}
{% form_theme form '@SyliusShop/form/theme.html.twig' %}

{% block title %}{{ 'tmonier_quote_request.ui.request_a_quote'|trans }} | {{ parent() }}{% endblock %}

{% block content %}
    <div class="container mb-auto">
        <div class="my-4">
            {{ breadcrumbs([
                { label: 'sylius.ui.home'|trans, path: path('sylius_shop_homepage') },
                { label: 'tmonier_quote_request.ui.request_a_quote'|trans, active: true },
            ]) }}
        </div>
        {% include '@SyliusShop/shared/flashes.html.twig' %}
        <h1 class="h2 mb-2">{{ 'tmonier_quote_request.ui.request_a_quote'|trans }}</h1>
        <p class="text-body-secondary mb-4">{{ 'tmonier_quote_request.ui.request_a_quote_help'|trans }}</p>

        {% if quote_request.lines is empty %}
            <div class="alert alert-light" {{ sylius_test_html_attribute('tmonier-quote-empty') }}>
                {{ 'tmonier_quote_request.ui.empty_quote_request'|trans }}
                <a href="{{ path('sylius_shop_homepage') }}">{{ 'sylius.ui.continue_shopping'|trans }}</a>
            </div>
            {% do form.setRendered %}
        {% else %}
            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
            {{ form_errors(form) }}
            <div class="row g-4">
                <div class="col-12 col-lg-7">
                    <div class="card">
                        <div class="card-header fw-bold">{{ 'tmonier_quote_request.ui.products'|trans }}</div>
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>{{ 'sylius.ui.product'|trans }}</th>
                                        <th class="text-end">{{ 'tmonier_quote_request.ui.catalog_price'|trans }}</th>
                                        <th style="width: 9rem">{{ 'tmonier_quote_request.form.desired_quantity'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for line_form in form.lines %}
                                        {% set line = line_form.vars.data %}
                                        <tr {{ sylius_test_html_attribute('tmonier-quote-line', line.variantCode) }}>
                                            <td>
                                                <div class="fw-semibold">{{ line.productName }}</div>
                                                {% if line.variantName and line.variantName != line.productName %}<div class="small text-body-secondary">{{ line.variantName }}</div>{% endif %}
                                            </td>
                                            <td class="text-end text-nowrap">{{ line.catalogUnitPrice|sylius_format_money(quote_request.currencyCode, quote_request.localeCode) }}</td>
                                            <td>
                                                {{ form_widget(line_form.quantity) }}
                                                {{ form_errors(line_form.quantity) }}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        <div class="card-footer small text-body-secondary">{{ 'tmonier_quote_request.form.zero_to_remove'|trans }}</div>
                    </div>
                    <div class="mt-3">
                        <a href="{{ path('sylius_shop_homepage') }}" class="link-reset small">{{ ux_icon('tabler:plus', {'class': 'icon'}) }} {{ 'tmonier_quote_request.ui.add_more_products'|trans }}</a>
                    </div>
                </div>
                <div class="col-12 col-lg-5">
                    <div class="card">
                        <div class="card-header fw-bold">{{ 'tmonier_quote_request.ui.your_details'|trans }}</div>
                        <div class="card-body">
                            {{ form_row(form.company) }}
                            <div class="row">
                                <div class="col-sm-6">{{ form_row(form.firstName) }}</div>
                                <div class="col-sm-6">{{ form_row(form.lastName) }}</div>
                            </div>
                            {{ form_row(form.email) }}
                            {% if is_guest %}
                                <p class="small text-body-secondary">{{ 'tmonier_quote_request.ui.guest_link_help'|trans }}</p>
                            {% endif %}
                            {{ form_row(form.phoneNumber) }}
                            {{ form_row(form.vatNumber) }}
                            {{ form_row(form.message) }}
                            <div style="position: absolute; left: -10000px; top: auto; width: 1px; height: 1px; overflow: hidden;" aria-hidden="true">
                                {{ form_row(form.website) }}
                            </div>
                            {{ form_rest(form) }}
                            <button type="submit" class="btn btn-primary w-100" {{ sylius_test_html_attribute('tmonier-quote-submit') }}>
                                {{ ux_icon('tabler:send', {'class': 'icon'}) }}
                                {{ 'tmonier_quote_request.ui.send_request'|trans }}
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            {{ form_end(form) }}
        {% endif %}
    </div>
{% endblock %}
