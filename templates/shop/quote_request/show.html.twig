{% extends '@SyliusShop/shared/layout/base.html.twig' %}
{% from '@SyliusShop/shared/breadcrumbs.html.twig' import breadcrumbs %}

{% block title %}{{ 'tmonier_quote_request.ui.quote_number'|trans({'%number%': quote_request.number}) }} | {{ parent() }}{% endblock %}

{% block content %}
    <div class="container mb-auto">
        <div class="row my-4">
            <div class="col-12">
                {% if from_account %}
                    {{ breadcrumbs([
                        { label: 'sylius.ui.home'|trans, path: path('sylius_shop_homepage') },
                        { label: 'sylius.ui.my_account'|trans, path: path('sylius_shop_account_dashboard') },
                        { label: 'tmonier_quote_request.ui.my_quotes'|trans, path: path('tmonier_quote_request_shop_account_index') },
                        { label: quote_request.number, active: true },
                    ]) }}
                {% else %}
                    {{ breadcrumbs([
                        { label: 'sylius.ui.home'|trans, path: path('sylius_shop_homepage') },
                        { label: 'tmonier_quote_request.ui.quote_number'|trans({'%number%': quote_request.number}), active: true },
                    ]) }}
                {% endif %}
            </div>
            {% if from_account %}
                <div class="col-12 col-md-3 mb-4 mb-md-0">
                    <div class="mb-3">{{ knp_menu_render('sylius_shop.account', {'template': '@SyliusShop/account/menu/content.html.twig'}) }}</div>
                </div>
            {% endif %}
            <div class="col-12 {{ from_account ? 'col-md-9' : '' }}" {{ sylius_test_html_attribute('tmonier-quote', quote_request.number) }}>
                {% include '@SyliusShop/shared/flashes.html.twig' %}
                {% include '@TmonierSyliusQuoteRequestPlugin/shop/quote_request/_content.html.twig' %}
            </div>
        </div>
    </div>
{% endblock %}
