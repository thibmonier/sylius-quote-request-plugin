{% set quote_request = hookable_metadata.context.quote_request %}
{% set icons = { review: 'tabler:eye-check', revise: 'tabler:pencil', decline: 'tabler:x', expire: 'tabler:clock-x', cancel: 'tabler:ban' } %}

<div class="col-12 col-md-6 d-flex flex-wrap gap-2 justify-content-md-end align-items-center d-print-none">
    {% for transition in hookable_metadata.context.transitions %}
        {% if transition != 'propose' and tmonier_quote_request_can(quote_request, transition) %}
            <form method="post" action="{{ path('tmonier_quote_request_admin_quote_request_transition', {'id': quote_request.id, 'transition': transition}) }}" class="d-inline">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('tmonier_quote_request_admin_' ~ transition ~ '_' ~ quote_request.id) }}">
                <button type="submit" class="btn {{ transition in ['decline', 'cancel'] ? 'btn-outline-danger' : '' }}" {{ sylius_test_html_attribute('tmonier-quote-transition', transition) }}>
                    {{ ux_icon(icons[transition]|default('tabler:arrow-right'), {'class': 'icon'}) }}
                    {{ ('tmonier_quote_request.ui.transition.' ~ transition)|trans }}
                </button>
            </form>
        {% endif %}
    {% endfor %}
    {% if hookable_metadata.context.can_convert %}
        <a class="btn btn-primary" href="{{ path('tmonier_quote_request_admin_quote_request_convert', {'id': quote_request.id}) }}" {{ sylius_test_html_attribute('tmonier-quote-convert') }}>
            {{ ux_icon('tabler:shopping-cart-check', {'class': 'icon'}) }}
            {{ 'tmonier_quote_request.ui.convert_to_order'|trans }}
        </a>
    {% endif %}
    {% if quote_request.order is not null and quote_request.order.state != 'cart' %}
        <a class="btn" href="{{ path('sylius_admin_order_show', {'id': quote_request.order.id}) }}" {{ sylius_test_html_attribute('tmonier-quote-order') }}>
            {{ ux_icon('tabler:receipt', {'class': 'icon'}) }}
            {{ 'tmonier_quote_request.ui.order_number'|trans({'%number%': quote_request.order.number}) }}
        </a>
    {% endif %}
</div>
