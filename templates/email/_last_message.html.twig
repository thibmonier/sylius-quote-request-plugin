{% set message = quoteRequest.messages|last %}
{% if message %}
    <div style="margin: 20px 0; padding: 12px 16px; background: #f6f6f6; border-left: 3px solid #1abb9c;">
        <div style="font-size: 13px; color: #888;">{{ message.authorName|default(('tmonier_quote_request.ui.author.' ~ message.authorType)|trans({}, null, localeCode))|e }}</div>
        <div>{{ message.body|e|nl2br }}</div>
    </div>
{% endif %}
