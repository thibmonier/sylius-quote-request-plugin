{% extends '@SyliusCore/Email/layout.html.twig' %}

{% block subject %}
    {{- 'tmonier_quote_request.email.admin_customer_message.subject'|trans({'%number%': quoteRequest.number}, null, localeCode) -}}
{% endblock %}

{% block content %}
    <div style="text-align: left;">
        <p>{{ 'tmonier_quote_request.email.admin_customer_message.intro'|trans({'%number%': quoteRequest.number, '%channel%': channel.name}, null, localeCode)|e }}</p>
        {% include '@TmonierSyliusQuoteRequestPlugin/email/_last_message.html.twig' %}
        {% include '@TmonierSyliusQuoteRequestPlugin/email/_admin_link.html.twig' %}
    </div>
{% endblock %}
