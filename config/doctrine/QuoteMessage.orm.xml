<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">

    <mapped-superclass name="Tmonier\SyliusQuoteRequestPlugin\Entity\QuoteMessage" table="tmonier_quote_request_message">
        <id name="id" column="id" type="integer">
            <generator strategy="AUTO" />
        </id>

        <field name="authorType" column="author_type" type="string" length="16" />
        <field name="authorName" column="author_name" type="string" length="255" nullable="true" />
        <field name="body" column="body" type="text" />
        <field name="createdAt" column="created_at" type="datetime_immutable" />

        <many-to-one field="quoteRequest" target-entity="Tmonier\SyliusQuoteRequestPlugin\Entity\QuoteRequestInterface" inversed-by="messages">
            <join-column name="quote_request_id" referenced-column-name="id" nullable="false" on-delete="CASCADE" />
        </many-to-one>
    </mapped-superclass>

</doctrine-mapping>
