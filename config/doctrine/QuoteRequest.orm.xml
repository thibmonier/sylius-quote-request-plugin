<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">

    <mapped-superclass name="Tmonier\SyliusQuoteRequestPlugin\Entity\QuoteRequest" table="tmonier_quote_request">
        <indexes>
            <index name="tmonier_quote_request_status_idx" columns="status,valid_until" />
            <index name="tmonier_quote_request_created_at_idx" columns="created_at" />
        </indexes>

        <id name="id" column="id" type="integer">
            <generator strategy="AUTO" />
        </id>

        <field name="number" column="number" type="string" length="32" nullable="true" unique="true" />
        <field name="status" column="status" type="string" length="32" />
        <field name="token" column="token" type="string" length="64" unique="true" />
        <field name="localeCode" column="locale_code" type="string" length="12" />
        <field name="currencyCode" column="currency_code" type="string" length="3" />
        <field name="email" column="email" type="string" length="255" />
        <field name="company" column="company" type="string" length="255" nullable="true" />
        <field name="firstName" column="first_name" type="string" length="255" nullable="true" />
        <field name="lastName" column="last_name" type="string" length="255" nullable="true" />
        <field name="phoneNumber" column="phone_number" type="string" length="64" nullable="true" />
        <field name="vatNumber" column="vat_number" type="string" length="64" nullable="true" />
        <field name="discountAmount" column="discount_amount" type="integer" nullable="true" />
        <field name="discountPercentage" column="discount_percentage" type="float" nullable="true" />
        <field name="validUntil" column="valid_until" type="datetime_immutable" nullable="true" />
        <field name="internalNote" column="internal_note" type="text" nullable="true" />
        <field name="createdAt" column="created_at" type="datetime_immutable" />
        <field name="updatedAt" column="updated_at" type="datetime_immutable" nullable="true" />
        <field name="proposedAt" column="proposed_at" type="datetime_immutable" nullable="true" />
        <field name="acceptedAt" column="accepted_at" type="datetime_immutable" nullable="true" />
        <field name="orderedAt" column="ordered_at" type="datetime_immutable" nullable="true" />

        <many-to-one field="channel" target-entity="Sylius\Component\Core\Model\ChannelInterface">
            <join-column name="channel_id" referenced-column-name="id" nullable="false" on-delete="CASCADE" />
        </many-to-one>

        <many-to-one field="customer" target-entity="Sylius\Component\Core\Model\CustomerInterface">
            <join-column name="customer_id" referenced-column-name="id" nullable="true" on-delete="SET NULL" />
        </many-to-one>

        <many-to-one field="order" target-entity="Sylius\Component\Core\Model\OrderInterface">
            <join-column name="order_id" referenced-column-name="id" nullable="true" on-delete="SET NULL" />
        </many-to-one>

        <one-to-many field="lines" target-entity="Tmonier\SyliusQuoteRequestPlugin\Entity\QuoteRequestLineInterface" mapped-by="quoteRequest" orphan-removal="true">
            <cascade>
                <cascade-all />
            </cascade>
            <order-by>
                <order-by-field name="id" direction="ASC" />
            </order-by>
        </one-to-many>

        <one-to-many field="messages" target-entity="Tmonier\SyliusQuoteRequestPlugin\Entity\QuoteMessageInterface" mapped-by="quoteRequest" orphan-removal="true">
            <cascade>
                <cascade-all />
            </cascade>
            <order-by>
                <order-by-field name="createdAt" direction="ASC" />
                <order-by-field name="id" direction="ASC" />
            </order-by>
        </one-to-many>
    </mapped-superclass>

</doctrine-mapping>
