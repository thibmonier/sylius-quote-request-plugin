<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">

    <mapped-superclass name="Tmonier\SyliusQuoteRequestPlugin\Entity\QuoteRequestLine" table="tmonier_quote_request_line">
        <id name="id" column="id" type="integer">
            <generator strategy="AUTO" />
        </id>

        <field name="productName" column="product_name" type="string" length="255" nullable="true" />
        <field name="variantName" column="variant_name" type="string" length="255" nullable="true" />
        <field name="variantCode" column="variant_code" type="string" length="255" nullable="true" />
        <field name="quantity" column="quantity" type="integer" />
        <field name="requestedQuantity" column="requested_quantity" type="integer" nullable="true" />
        <field name="catalogUnitPrice" column="catalog_unit_price" type="integer" />
        <field name="unitPrice" column="unit_price" type="integer" nullable="true" />

        <many-to-one field="quoteRequest" target-entity="Tmonier\SyliusQuoteRequestPlugin\Entity\QuoteRequestInterface" inversed-by="lines">
            <join-column name="quote_request_id" referenced-column-name="id" nullable="false" on-delete="CASCADE" />
        </many-to-one>

        <many-to-one field="variant" target-entity="Sylius\Component\Core\Model\ProductVariantInterface">
            <join-column name="variant_id" referenced-column-name="id" nullable="true" on-delete="SET NULL" />
        </many-to-one>
    </mapped-superclass>

</doctrine-mapping>
